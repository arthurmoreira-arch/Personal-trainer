# Token do bot (fale com @BotFather no Telegram -> /newbot)
TELEGRAM_BOT_TOKEN=
# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Seu ID numérico do Telegram (o bot te diz ao mandar /start). Separe vários com vírgula.
ALLOWED_USER_IDS=

# Opcionais
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
TZ_NAME=America/Sao_Paulo
DB_PATH=data/coach.db
# Horários em que o bot checa sua proteína do dia
PROTEIN_CHECK_TIMES=15:00,20:30
# Feedback semanal: 0=segunda ... 6=domingo
WEEKLY_FEEDBACK_DAY=6
WEEKLY_FEEDBACK_TIME=19:00
